# Copy to .env and fill in. Values come from the Supabase dashboard.

# Runtime connection. Project Settings → Database → Connection string → Transaction
# pooler (port 6543). The pgbouncer flag is required or Prisma's prepared
# statements break; connection_limit keeps serverless functions from exhausting
# the pool.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Schema changes only. Same page, Session pooler (port 5432). `prisma db push`
# and `prisma migrate` cannot run through pgbouncer, so they use this instead.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth. Project Settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only. Used by the provisioning scripts to create accounts.
# Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
