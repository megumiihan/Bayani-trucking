// Bayani Trucking — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used at runtime by the app.
  url       = env("DATABASE_URL")
  // Unpooled connection, used by `prisma db push` and `migrate`, which
  // cannot run through pgbouncer.
  directUrl = env("DIRECT_URL")
}

// 1. EMPLOYEES TABLE (Master list of drivers & helpers)
model Employee {
  id                 String       @id @default(uuid())
  fullName           String
  role               EmployeeRole // DRIVER, HELPER, BOTH
  isActive           Boolean      @default(true) // Set to false if they resign
  remarks            String?
  /// Bounty experience tag, e.g. oldbounty / newbounty.
  bountyExp          String       @default("oldbounty")
  /// Object path in the `employee-photos` storage bucket, e.g. "<id>/1732000000000.webp".
  photoPath          String?
  /// Regular (permanent) employee. Only regulars carry PhilHealth / SSS details.
  isRegular          Boolean      @default(false)
  /// Government IDs. Sensitive: read only via lib/queries/governmentIds.ts (admin).
  philhealthNumber   String?
  sssNumber          String?
  /// Object paths in the PRIVATE `employee-documents` bucket; viewed via signed URLs.
  philhealthCardPath String?
  sssCardPath        String?
  createdAt          DateTime     @default(now())

  // Optional: Allows querying all shipments completed by this employee
  driverShipments     ShipmentLog[]   @relation("DriverRelation")
  helperShipments     ShipmentLog[]   @relation("HelperRelation")
  profile             Profile?
  salaryPayments      SalaryPayment[]
  responsibleExpenses Expense[]
}

enum EmployeeRole {
  DRIVER
  HELPER
  BOTH
  /// Office staff. Never a driver/helper on a shipment; logs shipments and payouts.
  SECRETARY
}

// 1b. PROFILES (one row per Supabase Auth user)
model Profile {
  /// Matches the Supabase `auth.users.id` for this person.
  id                String    @id
  email             String    @unique
  role              AppRole   @default(EMPLOYEE)
  /// Null for office staff who are not drivers or helpers.
  employeeId        String?   @unique
  employee          Employee? @relation(fields: [employeeId], references: [id])
  /// AES-256-GCM ciphertext of the login password (iv:tag:data, base64) so the
  /// admin can look it up. Key: CREDENTIALS_ENCRYPTION_KEY. Null = not on file.
  encryptedPassword String?
  createdAt         DateTime  @default(now())

  createdShipments         ShipmentLog[]
  recordedPayments         SalaryPayment[]
  loggedExpenses           Expense[]
  loggedBillables          Billable[]
  loggedDisbursements      Disbursement[]
  loggedCollectionReceipts CollectionReceipt[]
  rateChanges              DestinationRateHistory[]
  clientRateChanges        ClientRateHistory[]
  loggedTruckRepairs       TruckRepair[]
  loggedTruckChecks        TruckCheck[]
  createdLeads             Lead[]
  loggedLeadActivities     LeadActivity[]
}

enum AppRole {
  ADMIN
  /// Logs and edits shipments and payouts, sees employees and trucks, but not totals.
  SECRETARY
  EMPLOYEE
}

// 2. TRUCKS TABLE (Master fleet list)
model Truck {
  id                    String   @id @default(uuid()) // TruckId
  mvFileNo              String   @unique
  plateNumber           String   @unique
  engineNo              String
  chassisNo             String
  yearModel             Int
  make                  String
  wheelCount            Int      @default(6)
  truckType             String
  crIssueDate           DateTime
  firstRegistrationDate DateTime
  isActive              Boolean  @default(true)
  /// Year the company bought the truck (often later than yearModel).
  purchaseYear          Int?
  purchasePrice         Float?
  /// Year the truck was sold. Set when the truck is marked inactive.
  soldYear              Int?
  /// Object path in the PRIVATE `truck-documents` bucket; viewed via signed URLs.
  certificatePath       String?
  /// Original file name of the certificate, for display.
  certificateName       String?
  createdAt             DateTime @default(now())

  shipments ShipmentLog[]
  expenses  Expense[]
  repairs   TruckRepair[]
  checks    TruckCheck[]
  documents TruckDocument[]
}

/// Title, LTFRB franchise, NMIS accreditation, comprehensive insurance, etc.
/// One row per truck and document type (keys in TRUCK_DOCUMENT_TYPES, lib/truckMaintenance.ts).
model TruckDocument {
  id             String   @id @default(uuid())
  truckId        String
  truck          Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  docType        String
  /// Next renewal; shows on the maintenance board when overdue or due soon.
  renewalDueDate DateTime
  /// Object path in the PRIVATE `truck-documents` bucket; viewed via signed URLs.
  filePath       String?
  fileName       String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([truckId, docType])
}

/// Repairs and scheduled maintenance done on a truck.
model TruckRepair {
  id              String   @id @default(uuid())
  truckId         String
  truck           Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  date            DateTime
  /// MaintenanceType.key (e.g. OIL_CHANGE, REPAIR).
  maintenanceType String
  description     String   @default("")
  shop            String   @default("")
  cost            Float    @default(0)
  /// The MAINTENANCE_AND_REPAIRS expense created for this repair's cost, if any.
  expenseId       String?  @unique
  expense         Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       Profile  @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  @@index([truckId, date])
}

/// Monthly condition checklist for a truck.
model TruckCheck {
  id          String   @id @default(uuid())
  truckId     String
  truck       Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  checkedAt   DateTime
  /// { [itemKey]: "ok" | "issue" } using TruckCheckItem keys.
  items       Json
  notes       String   @default("")
  createdById String
  createdBy   Profile  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([truckId, checkedAt])
}

/// Scheduled maintenance types (and the unscheduled "REPAIR" type), editable by admins
/// on the Trucks page and applied to every truck. Removing one archives it so old
/// repairs keep their label.
model MaintenanceType {
  /// Stored on TruckRepair.maintenanceType.
  key            String   @id
  label          String
  /// Months between services. Null = not scheduled (one-off repairs).
  intervalMonths Int?
  /// Mandatory types show as "Required" when overdue; the rest as "Check".
  mandatory      Boolean  @default(false)
  /// Only applies to refrigerated trucks.
  reeferOnly     Boolean  @default(false)
  sortOrder      Int      @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

/// Items on the monthly condition checklist, applied to every truck.
/// Removing one archives it so old checks keep their label.
model TruckCheckItem {
  /// Key used in TruckCheck.items.
  key        String   @id
  label      String
  reeferOnly Boolean  @default(false)
  sortOrder  Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// 3. CLIENT MANAGEMENT
model Client {
  id                 String          @id @default(uuid())
  name               String          @unique
  /// Registered business name, e.g. "PEPSI COLA PRODUCTS PHILIPPINES INC".
  legalName          String          @default("")
  address            String          @default("")
  /// BIR TIN, stored as "000 168 541 067" (branch code last).
  tin                String          @default("")
  /// One-off client added from Bookkeeping ("Others"). Listed on Clients &
  /// suppliers and in bookkeeping dropdowns, hidden from the Clients page,
  /// Routes & Rates and the shipment form.
  isTemporary        Boolean         @default(false)
  calcType           CalculationType @default(DESTINATION)
  pigheadDriverRate  Float?
  pigheadHelperRate  Float?
  platformShare      Float?
  platformDriverRate Float?
  platformHelperRate Float?
  createdAt          DateTime        @default(now())

  routes             DestinationRoute[]
  shipments          ShipmentLog[]
  rateHistory        DestinationRateHistory[]
  clientRateHistory  ClientRateHistory[]
  billables          Billable[]
  collectionReceipts CollectionReceipt[]
  leads              Lead[]
}

/// Vendors the company buys from (fuel, parts, repairs). Their registered name,
/// address and TIN fill in expense and disbursement entries. Not unique by name:
/// one company can have several branches, each with its own address and TIN.
model Supplier {
  id        String   @id @default(uuid())
  name      String
  address   String   @default("")
  /// BIR TIN, stored as "009 837 423 00020" (branch code last).
  tin       String   @default("")
  createdAt DateTime @default(now())

  @@index([name])
}

enum CalculationType {
  DESTINATION
  WEIGHT
  ANIMAL_HEADCOUNT
  PLATFORM
}

// 4. ROUTE MASTER RATES
model DestinationRoute {
  id                  String   @id @default(uuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id])
  routeName           String
  /// Distance band, e.g. "1-120KM". Empty string for clients priced per area.
  distance            String   @default("")
  driverBaseRate      Float
  helperBaseRate      Float
  extraHelperBaseRate Float
  weightKg            Int?
  sameDriverRate      Float?
  newDriverRate       Float?
  newHelperRate       Float?
  createdAt           DateTime @default(now())

  rateHistory DestinationRateHistory[]

  @@unique([clientId, routeName, distance, weightKg])
}

// Audit log when admins add or change destination, weight or livestock route rates.
model DestinationRateHistory {
  id                      String            @id @default(uuid())
  clientId                String
  client                  Client            @relation(fields: [clientId], references: [id])
  destinationRouteId      String?
  destinationRoute        DestinationRoute? @relation(fields: [destinationRouteId], references: [id], onDelete: SetNull)
  routeName               String
  distance                String            @default("")
  prevDriverBaseRate      Float
  prevHelperBaseRate      Float
  prevExtraHelperBaseRate Float
  newDriverBaseRate       Float
  newHelperBaseRate       Float
  newExtraHelperBaseRate  Float
  /// Weight tier (kg) when the route belongs to a weight-based client.
  weightKg                Int?
  prevSameDriverRate      Float?
  prevNewDriverRate       Float?
  prevNewHelperRate       Float?
  newSameDriverRate       Float?
  newNewDriverRate        Float?
  newNewHelperRate        Float?
  /// True when this entry records a newly added route rather than an edit.
  isCreated               Boolean           @default(false)
  changedById             String
  changedBy               Profile           @relation(fields: [changedById], references: [id])
  changedAt               DateTime          @default(now())

  @@index([clientId, changedAt(sort: Desc)])
}

enum ClientRateHistoryKind {
  LIVESTOCK
  PLATFORM
}

// Audit log when admins change livestock or platform client-level rates.
model ClientRateHistory {
  id                     String                @id @default(uuid())
  clientId               String
  client                 Client                @relation(fields: [clientId], references: [id])
  kind                   ClientRateHistoryKind
  prevPigheadDriverRate  Float?
  prevPigheadHelperRate  Float?
  newPigheadDriverRate   Float?
  newPigheadHelperRate   Float?
  prevPlatformShare      Float?
  prevPlatformDriverRate Float?
  prevPlatformHelperRate Float?
  newPlatformShare       Float?
  newPlatformDriverRate  Float?
  newPlatformHelperRate  Float?
  changedById            String
  changedBy              Profile               @relation(fields: [changedById], references: [id])
  changedAt              DateTime              @default(now())

  @@index([clientId, kind, changedAt(sort: Desc)])
}

// 5. SHIPMENT LOGS (Transactional Event)
model ShipmentLog {
  id   String   @id @default(uuid())
  date DateTime @default(now())

  // --- Truck Info (snapshot + master link) ---
  plateNumber String // Snapshot plate number string
  truckId     String?
  truck       Truck?  @relation(fields: [truckId], references: [id])

  shipmentNumber String
  clientNumber   String?
  waybillNumber  String?

  // --- Dynamic Input Fields ---
  routeName    String?
  distance     String?
  weightKg     Float?
  headCount    Int?
  pigheadCount Int?
  platformRate Float?

  // --- Personnel Involved ---
  driverName String // Snapshot driver name
  driverId   String?
  driver     Employee? @relation("DriverRelation", fields: [driverId], references: [id])

  helperName String? // Snapshot helper name
  helperId   String?
  helper     Employee? @relation("HelperRelation", fields: [helperId], references: [id])

  hasExtraHelper   Boolean @default(false)
  extraHelperName  String?
  extraHelperNote  String?
  isDriverAsHelper Boolean @default(false)

  // --- Financial Snapshot ---
  driverPayout      Float
  helperPayout      Float
  extraHelperPayout Float @default(0.0)

  remarks             String?
  isFlagged           Boolean @default(false)
  isApproved          Boolean @default(false)
  /// Secretary's pre-approval. Display only: payouts still count once isApproved (admin) is set.
  isSecretaryApproved Boolean @default(false)

  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  createdById String
  createdBy   Profile  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// 6. SALARY PAYMENTS (cash paid to a crew member)
model SalaryPayment {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  amount      Float
  paidAt      DateTime
  note        String?
  createdById String
  createdBy   Profile  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

enum ExpenseCategory {
  SALARY
  GOVERNMENT_FEES
  INSURANCE_FEES
  MAINTENANCE_AND_REPAIRS
  ACCIDENTS
  LOAN_INTERESTS
  FUEL
  OTHERS
}

model Expense {
  id           String          @id @default(uuid())
  date         DateTime
  category     ExpenseCategory
  amount       Float
  address      String          @default("")
  invoiceNo    String          @default("")
  vatRegNo     String          @default("")
  vatPurchase  Float           @default(0)
  inputTax     Float           @default(0)
  description  String?
  isFlagged    Boolean         @default(false)
  isReimbursed Boolean         @default(false)
  isCredit     Boolean         @default(false)
  employeeId   String?
  employee     Employee?       @relation(fields: [employeeId], references: [id])
  truckId      String?
  truck        Truck?          @relation(fields: [truckId], references: [id])
  createdById  String
  createdBy    Profile         @relation(fields: [createdById], references: [id])
  truckRepair  TruckRepair?
  createdAt    DateTime        @default(now())
}

// 8. BOOKKEEPING LEDGERS
model Billable {
  id                      String   @id @default(uuid())
  date                    DateTime
  invoiceNo               String   @unique
  vatRegNo                String
  buyerName               String   @default("")
  buyerAddress            String   @default("")
  clientId                String
  client                  Client   @relation(fields: [clientId], references: [id])
  totalInvoiceAmt         Float    @default(0)
  taxableAmt              Float
  outputTax               Float    @default(0)
  withholdingTax          Float    @default(0)
  totalTax                Float    @default(0)
  vatDeduction            Boolean  @default(true)
  withholdingTaxDeduction Boolean  @default(false)
  createdById             String
  createdBy               Profile  @relation(fields: [createdById], references: [id])
  createdAt               DateTime @default(now())
  collectionItem          CollectionReceiptItem?

  @@index([date(sort: Desc)])
  @@index([clientId])
}

model Disbursement {
  id          String   @id @default(uuid())
  date        DateTime
  payee       String
  amount      Float
  referenceNo String?
  invoiceNo   String   @default("")
  vatRegNo    String   @default("")
  description String?
  createdById String
  createdBy   Profile  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date(sort: Desc)])
}

model CollectionReceipt {
  id               String   @id @default(uuid())
  datePaid         DateTime
  orNumber         String   @unique
  collectionAmount Float    @map("amount")
  paymentDetails   String   @default("")
  whoPaid          String
  whoReceived      String
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  clientName       String   @default("")
  createdById      String
  createdBy        Profile  @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  items            CollectionReceiptItem[]

  @@index([datePaid(sort: Desc)])
  @@index([clientId])
}

/// One sales invoice (billable) paid by a collection receipt. Buyer details and the
/// amount due are snapshotted when the receipt is logged.
model CollectionReceiptItem {
  id           String            @id @default(uuid())
  receiptId    String
  receipt      CollectionReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  /// Unique: an SI can only be collected once.
  billableId   String?           @unique
  billable     Billable?         @relation(fields: [billableId], references: [id], onDelete: SetNull)
  invoiceNo    String
  buyerName    String            @default("")
  buyerAddress String            @default("")
  vatRegNo     String            @default("")
  /// Total invoice amount − withholding tax.
  amountDue    Float

  @@index([receiptId])
}

// 9. SALES LEADS (prospective clients — the Leads tab)
enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUOTED
  WON
  LOST
  DO_NOT_CONTACT
}

enum LeadType {
  CONTRACT
  ONE_TIME_MOVE
}

enum LeadSource {
  WEBSITE
  FACEBOOK_SEARCH
  FACEBOOK_PAGE_INQUIRY
  REFERRAL
  WALK_IN
  OTHER
}

enum LeadActivityKind {
  CALL
  EMAIL
  FB_MESSAGE
  MEETING
  NOTE
}

model Lead {
  id             String     @id @default(uuid())
  companyName    String
  contactPerson  String     @default("")
  phone          String     @default("")
  email          String     @default("")
  website        String     @default("")
  facebookUrl    String     @default("")
  municipality   String     @default("")
  /// One of REGION_II_PROVINCES in lib/leads.ts, or free text.
  province       String     @default("")
  /// e.g. poultry, piggery, rice mill, hardware.
  industry       String     @default("")
  type           LeadType   @default(CONTRACT)
  source         LeadSource @default(OTHER)
  status         LeadStatus @default(NEW)
  nextFollowUpAt DateTime?
  notes          String     @default("")
  /// Billing client created when this lead was won.
  clientId       String?
  client         Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      Profile    @relation(fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  activities LeadActivity[]

  @@index([status])
  @@index([nextFollowUpAt])
}

model LeadActivity {
  id             String           @id @default(uuid())
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind           LeadActivityKind
  summary        String
  outcome        String           @default("")
  occurredAt     DateTime         @default(now())
  emailSubject   String?
  /// SMTP Message-ID of an email sent from the app.
  gmailMessageId String?
  createdById    String
  createdBy      Profile          @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([leadId, occurredAt(sort: Desc)])
}

/// Reusable pitch emails. Placeholders: {{contactPerson}}, {{companyName}}, {{municipality}}.
model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
