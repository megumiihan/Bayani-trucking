// Bayani Trucking — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection, used at runtime by the app.
  url       = env("DATABASE_URL")
  // Unpooled connection, used by `prisma db push` and `migrate`, which
  // cannot run through pgbouncer.
  directUrl = env("DIRECT_URL")
}

// 1. EMPLOYEES TABLE (Master list of drivers & helpers)
model Employee {
  id        String       @id @default(uuid())
  fullName  String
  role      EmployeeRole // DRIVER, HELPER, BOTH
  isActive  Boolean      @default(true) // Set to false if they resign
  remarks   String?
  /// Bounty experience tag, e.g. oldbounty / newbounty.
  bountyExp String       @default("oldbounty")
  createdAt DateTime     @default(now())

  // Optional: Allows querying all shipments completed by this employee
  driverShipments ShipmentLog[] @relation("DriverRelation")
  helperShipments ShipmentLog[] @relation("HelperRelation")
  profile         Profile?
  salaryPayments  SalaryPayment[]
  responsibleExpenses Expense[]
}

enum EmployeeRole {
  DRIVER
  HELPER
  BOTH
}

// 1b. PROFILES (one row per Supabase Auth user)
model Profile {
  /// Matches the Supabase `auth.users.id` for this person.
  id         String    @id
  email      String    @unique
  role       AppRole   @default(EMPLOYEE)
  /// Null for office staff who are not drivers or helpers.
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())

  createdShipments           ShipmentLog[]
  recordedPayments           SalaryPayment[]
  loggedExpenses             Expense[]
  loggedBillables            Billable[]
  loggedDisbursements        Disbursement[]
  loggedCollectionReceipts   CollectionReceipt[]
  rateChanges                DestinationRateHistory[]
  clientRateChanges          ClientRateHistory[]
}

enum AppRole {
  ADMIN
  EMPLOYEE
}

// 2. TRUCKS TABLE (Master fleet list)
model Truck {
  id                    String   @id @default(uuid()) // TruckId
  mvFileNo              String   @unique
  plateNumber           String   @unique
  engineNo              String
  chassisNo             String
  yearModel             Int
  make                  String
  wheelCount            Int      @default(6)
  truckType             String
  crIssueDate           DateTime
  firstRegistrationDate DateTime
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  shipments ShipmentLog[]
  expenses  Expense[]
}

// 3. CLIENT MANAGEMENT
model Client {
  id                 String          @id @default(uuid())
  name               String          @unique
  calcType           CalculationType @default(DESTINATION)
  pigheadDriverRate   Float?
  pigheadHelperRate   Float?
  platformShare       Float?
  platformDriverRate  Float?
  platformHelperRate  Float?
  createdAt           DateTime        @default(now())

  routes           DestinationRoute[]
  shipments        ShipmentLog[]
  rateHistory      DestinationRateHistory[]
  clientRateHistory ClientRateHistory[]
  billables            Billable[]
  collectionReceipts   CollectionReceipt[]
}

enum CalculationType {
  DESTINATION
  WEIGHT
  ANIMAL_HEADCOUNT
  PLATFORM
}

// 4. ROUTE MASTER RATES
model DestinationRoute {
  id                  String   @id @default(uuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id])
  routeName           String
  /// Distance band, e.g. "1-120KM". Empty string for clients priced per area.
  distance            String   @default("")
  driverBaseRate      Float
  helperBaseRate      Float
  extraHelperBaseRate Float
  weightKg            Int?
  sameDriverRate      Float?
  newDriverRate       Float?
  newHelperRate       Float?
  createdAt           DateTime @default(now())

  rateHistory DestinationRateHistory[]

  @@unique([clientId, routeName, distance, weightKg])
}

// Audit log when admins change destination-based route rates.
model DestinationRateHistory {
  id                     String            @id @default(uuid())
  clientId               String
  client                 Client            @relation(fields: [clientId], references: [id])
  destinationRouteId     String?
  destinationRoute       DestinationRoute? @relation(fields: [destinationRouteId], references: [id], onDelete: SetNull)
  routeName              String
  distance               String            @default("")
  prevDriverBaseRate     Float
  prevHelperBaseRate     Float
  prevExtraHelperBaseRate Float
  newDriverBaseRate      Float
  newHelperBaseRate      Float
  newExtraHelperBaseRate Float
  changedById            String
  changedBy              Profile           @relation(fields: [changedById], references: [id])
  changedAt              DateTime          @default(now())

  @@index([clientId, changedAt(sort: Desc)])
}

enum ClientRateHistoryKind {
  LIVESTOCK
  PLATFORM
}

// Audit log when admins change livestock or platform client-level rates.
model ClientRateHistory {
  id                      String                @id @default(uuid())
  clientId                String
  client                  Client                @relation(fields: [clientId], references: [id])
  kind                    ClientRateHistoryKind
  prevPigheadDriverRate   Float?
  prevPigheadHelperRate   Float?
  newPigheadDriverRate    Float?
  newPigheadHelperRate    Float?
  prevPlatformShare       Float?
  prevPlatformDriverRate  Float?
  prevPlatformHelperRate  Float?
  newPlatformShare        Float?
  newPlatformDriverRate   Float?
  newPlatformHelperRate   Float?
  changedById             String
  changedBy               Profile               @relation(fields: [changedById], references: [id])
  changedAt               DateTime              @default(now())

  @@index([clientId, kind, changedAt(sort: Desc)])
}

// 5. SHIPMENT LOGS (Transactional Event)
model ShipmentLog {
  id   String   @id @default(uuid())
  date DateTime @default(now())

  // --- Truck Info (snapshot + master link) ---
  plateNumber String // Snapshot plate number string
  truckId     String?
  truck       Truck?  @relation(fields: [truckId], references: [id])

  shipmentNumber String
  clientNumber   String?
  waybillNumber  String?

  // --- Dynamic Input Fields ---
  routeName  String?
  distance   String?
  weightKg   Float?
  headCount  Int?
  pigheadCount   Int?
  platformRate   Float?

  // --- Personnel Involved ---
  driverName String // Snapshot driver name
  driverId   String?
  driver     Employee? @relation("DriverRelation", fields: [driverId], references: [id])

  helperName String? // Snapshot helper name
  helperId   String?
  helper     Employee? @relation("HelperRelation", fields: [helperId], references: [id])

  hasExtraHelper   Boolean @default(false)
  extraHelperName  String?
  extraHelperNote  String?
  isDriverAsHelper Boolean @default(false)

  // --- Financial Snapshot ---
  driverPayout      Float
  helperPayout      Float
  extraHelperPayout Float @default(0.0)

  remarks   String?
  isFlagged Boolean @default(false)
  isApproved Boolean @default(false)

  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  createdById String
  createdBy   Profile  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// 6. SALARY PAYMENTS (cash paid to a crew member)
model SalaryPayment {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  amount     Float
  paidAt     DateTime
  note       String?
  createdById String
  createdBy   Profile  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

enum ExpenseCategory {
  SALARY
  GOVERNMENT_FEES
  INSURANCE_FEES
  MAINTENANCE_AND_REPAIRS
  ACCIDENTS
  LOAN_INTERESTS
  FUEL
  OTHERS
}

model Expense {
  id          String          @id @default(uuid())
  date        DateTime
  category    ExpenseCategory
  amount      Float
  address     String          @default("")
  invoiceNo   String          @default("")
  vatRegNo    String          @default("")
  vatPurchase Float           @default(0)
  inputTax    Float           @default(0)
  description String?
  isFlagged   Boolean         @default(false)
  isReimbursed Boolean        @default(false)
  isCredit     Boolean        @default(false)
  employeeId   String?
  employee     Employee?      @relation(fields: [employeeId], references: [id])
  truckId      String?
  truck        Truck?         @relation(fields: [truckId], references: [id])
  createdById String
  createdBy   Profile         @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
}

// 8. BOOKKEEPING LEDGERS
model Billable {
  id                      String   @id @default(uuid())
  date                    DateTime
  invoiceNo               String   @unique
  vatRegNo                String
  buyerName               String   @default("")
  buyerAddress            String   @default("")
  clientId                String?
  client                  Client?  @relation(fields: [clientId], references: [id])
  totalInvoiceAmt         Float    @default(0)
  taxableAmt              Float
  outputTax               Float    @default(0)
  withholdingTax          Float    @default(0)
  totalTax                Float    @default(0)
  vatDeduction            Boolean  @default(true)
  withholdingTaxDeduction Boolean  @default(false)
  createdById             String
  createdBy               Profile  @relation(fields: [createdById], references: [id])
  createdAt               DateTime @default(now())

  @@index([date(sort: Desc)])
}

model Disbursement {
  id          String   @id @default(uuid())
  date        DateTime
  payee       String
  amount      Float
  referenceNo String?
  description String?
  createdById String
  createdBy   Profile  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date(sort: Desc)])
}

model CollectionReceipt {
  id             String   @id @default(uuid())
  datePaid       DateTime
  orNumber       String   @unique
  amount         Float
  paymentDetails String   @default("")
  whoPaid        String
  whoReceived    String
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  clientName     String   @default("")
  createdById    String
  createdBy      Profile  @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([datePaid(sort: Desc)])
}
